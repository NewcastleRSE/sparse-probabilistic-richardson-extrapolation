<mujoco model="colliding_shapes">
    <option gravity="0 0 -9.81" timestep="{timestep}" integrator="RK4" tolerance="{tolerance}"/>

    <visual>
        <quality shadowsize="2048"/>
        <map znear="0.01"/>
    </visual>

    <asset>
        <!-- Floor material -->
        <texture name="grid" type="2d" builtin="checker" width="512" height="512"
                 rgb1="0.2 0.2 0.2" rgb2="0.85 0.85 0.85"/>
        <material name="floor_mat" texture="grid" texrepeat="12 12" reflectance="0.15"/>

        <!-- Shape materials -->
        <material name="red_mat"    rgba="0.9 0.2 0.2 1" specular="0.6" shininess="0.8"/>
        <material name="blue_mat"   rgba="0.2 0.4 0.9 1" specular="0.6" shininess="0.8"/>
        <material name="green_mat"  rgba="0.2 0.8 0.3 1" specular="0.6" shininess="0.8"/>
        <material name="yellow_mat" rgba="0.9 0.8 0.2 1" specular="0.6" shininess="0.8"/>
        <material name="purple_mat" rgba="0.6 0.3 0.8 1" specular="0.6" shininess="0.8"/>
    </asset>

    <worldbody>
        <!-- Camera -->
        <camera name="angled_view"
                pos="{camera_pos_x} {camera_pos_y} {camera_pos_z}"
                xyaxes="0.7 0.7 0  -0.3 0.3 0.9"/>

        <!-- Lights -->
        <light name="sun" pos="0 0 5" dir="0 0 -1" diffuse="1.5 1.5 1.5" specular="0.6 0.6 0.6"/>
        <light name="fill" pos="2 2 3" diffuse="0.6 0.6 0.6"/>

        <!-- Floor -->
        <geom name="floor" type="plane" size="5 5 0.1" material="floor_mat"/>

        <!-- Sphere A, linear and angular velocity of free joint stored in user: lx, ly, lz, ax, ay, az -->
        <body name="sphere_red" pos="-0.1 -0.1 0.5" user="1.0 0 0 0 0 0.5">
            <joint type="free" damping="0.01"/>
            <geom type="sphere" size="0.08" mass="1" material="red_mat" contype="1" conaffinity="1" solimp="0.95 0.95 0.001"/>            
        </body>

        <!-- Sphere B, linear and angular velocity of free joint stored in user: lx, ly, lz, ax, ay, az -->
        <body name="sphere_blue" pos="0.4 0.0 0.55" user="-1.0 0 0 0 0 -0.5">
            <joint type="free" damping="0.01"/>
            <geom type="sphere" size="0.08" mass="1" material="blue_mat" contype="1" conaffinity="1" solimp="0.95 0.95 0.001"/>
        </body>

        <!-- Green box, linear and angular velocity of free joint stored in user: lx, ly, lz, ax, ay, az  -->
        <body name="box_green" pos="-0.3 0.3 0.65" euler="0.5236 0.3491 0.7854" user="1.0 -0.5 0 1.5 0 4.5">
            <joint type="free" damping="0.01"/>
            <geom type="box" size="0.07 0.07 0.07" mass="1.2"
                  material="green_mat" contype="1" conaffinity="1"/>
        </body>

        <!-- Yellow cylinder, linear and angular velocity of free joint stored in user: lx, ly, lz, ax, ay, az -->
        <body name="cylinder_yellow" pos="-0.1 -0.4 0.65" euler="0.5236 0.3491 10.7854" user="0.2 1.0 0 0 4 -4.5">
            <joint type="free" damping="0.01"/>
            <geom type="cylinder" size="0.06 0.12" mass="1.1"
                  material="yellow_mat" contype="1" conaffinity="1"/>
        </body>
 

        <!-- Purple capsule, linear and angular velocity of free joint stored in user: lx, ly, lz, ax, ay, az  -->
        <body name="capsule_purple" pos="-0.3 0.1 0.7" user="1.0 -0.5 0 0 0 -0.5">
            <joint type="free" damping="0.01"/>
            <geom type="capsule" size="0.05 0.15" mass="1.0"
                  material="purple_mat" contype="1" conaffinity="1"/>
        </body>

    </worldbody>
</mujoco>
